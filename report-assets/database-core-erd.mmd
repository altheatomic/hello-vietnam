  PLACE_SUBCATEGORY ||--o{ PLACE : "classifies"
  PLACE ||--o{ PLACE_TAG : "tagged with"
  TAG ||--o{ PLACE_TAG : "describes"
  USER_ACCOUNT ||--o{ USER_EVENT_LOG : "generates"
  PLACE ||--o{ USER_EVENT_LOG : "receives events"
  USER_ACCOUNT ||--o{ PLAN : "creates"
  PROVINCE ||--o{ PLAN : "destination"
  PLAN ||--o{ PLAN_COMPONENT : "contains"
  PLACE ||--o{ PLAN_COMPONENT : "scheduled in"
