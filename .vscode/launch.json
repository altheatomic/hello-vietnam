{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile App (Default)",
      "request": "launch",
      "type": "dart",
      "program": "frontend/lib/main_mobile.dart"
    },
    {
      "name": "Admin Web (Chrome :3001)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "program": "frontend/lib/main_admin_web.dart",
      "args": [
        "--web-hostname",
        "localhost",
        "--web-port",
        "3001"
      ]
    },
    {
      "name": "Mobile Web (Chrome :3000)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "program": "frontend/lib/main_mobile.dart",
      "args": [
        "--web-hostname",
        "localhost",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "User (Android)",
      "request": "launch",
      "type": "dart",
      "program": "frontend/lib/main.dart"
    }
  ],
  "compounds": [
    {
      "name": "Run Mobile + Admin Web",
      "configurations": [
        "Mobile App (Default)",
        "Admin Web (Chrome :3001)"
      ],
      "stopAll": true
    }
  ]
}
