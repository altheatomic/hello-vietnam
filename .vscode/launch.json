{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "User App (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Admin App (Web)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_admin.dart",
      "deviceId": "chrome",
      "args": ["--web-hostname", "localhost", "--web-port", "3000"]
    }
  ]
}
